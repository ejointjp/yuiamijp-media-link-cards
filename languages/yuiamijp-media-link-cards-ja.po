#. Plugin Name of the plugin
#: yuiamijp-media-link-cards.php
msgid "yuiamijp Media Link Cards"
msgstr "yuiamijp Media Link Cards"

#. Description of the plugin
#: yuiamijp-media-link-cards.php
msgid ""
"Easily create promotional links for iPhone / iPad / Mac apps, music tracks, "
"Apple Books, and more."
msgstr ""
"iPhone / iPad / Macのアプリ、曲、Apple Booksなどの紹介リンクを手軽に作成でき"
"ます。"

#. Author of the plugin
#: yuiamijp-media-link-cards.php
msgid "Takashi Fujisaki"
msgstr "Takashi Fujisaki"

