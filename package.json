{
	"name": "yuiamijp-media-link-cards",
	"version": "1.0.0",
	"description": "Search the Apple ecosystem from the block editor and embed a rich card.",
	"author": "Takashi Fujisaki",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"packageManager": "pnpm@11.17.0",
	"scripts": {
		"build": "wp-scripts build",
		"format": "wp-scripts format src/*.js src/components && wp-scripts lint-style \"src/*.css\" --fix",
		"lint:css": "wp-scripts lint-style \"src/*.css\"",
		"lint:js": "wp-scripts lint-js src/*.js src/components",
		"lint:all": "pnpm lint:js && pnpm lint:css",
		"packages-update": "wp-scripts packages-update",
		"start": "wp-scripts start"
	},
	"devDependencies": {
		"@wordpress/api-fetch": "^7.52.0",
		"@wordpress/block-editor": "^16.0.0",
		"@wordpress/blocks": "^15.24.0",
		"@wordpress/components": "^37.0.0",
		"@wordpress/element": "^8.3.0",
		"@wordpress/i18n": "^6.24.0",
		"@wordpress/scripts": "^33.0.0"
	},
	"dependencies": {
		"react-loading": "^2.0.3"
	}
}
