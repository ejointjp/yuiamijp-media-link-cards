{
	"name": "su-applink",
	"version": "1.0.0",
	"description": "Example block scaffolded with Create Block tool.",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"build": "wp-scripts build",
		"format": "wp-scripts format src/*.js src/components src/*.css",
		"lint:css": "wp-scripts lint-style \"src/*.css\"",
		"lint:js": "wp-scripts lint-js src/*.js src/components",
		"lint:all": "pnpm lint:js && pnpm lint:css",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start"
	},
	"devDependencies": {
		"@wordpress/block-editor": "^16.0.0",
		"@wordpress/blocks": "^15.24.0",
		"@wordpress/components": "^37.0.0",
		"@wordpress/element": "^8.3.0",
		"@wordpress/i18n": "^6.24.0",
		"@wordpress/scripts": "^33.0.0"
	},
	"dependencies": {
		"react-icons": "^4.12.0",
		"react-loading": "^2.0.3"
	}
}
