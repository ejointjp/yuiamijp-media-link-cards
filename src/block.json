{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "yuiamijp/media-link-cards",
	"version": "0.1.0",
	"title": "Media Link Card",
	"category": "yuiamijp",
	"icon": "instagram",
	"description": "Create promotional links for iPhone / iPad / Mac apps, music tracks, Apple Books, and more.",
	"example": {},
	"supports": {
		"html": false
	},
	"textdomain": "yuiamijp-media-link-cards",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"keywords": [
		"link",
		"embed",
		"app",
		"apple",
		"embed",
		"link",
		"itunes",
		"iphone",
		"ipad",
		"mac",
		"book"
	],
	"attributes": {
		"app": {
			"type": "object",
			"default": {}
		},
		"entity": {
			"type": "string",
			"default": "software"
		}
	}
}
