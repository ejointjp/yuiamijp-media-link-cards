<?xml version="1.0"?>
<ruleset name="yuiamijp-media-link-cards">
	<description>WordPress Coding Standards for yuiamijp Media Link Cards</description>

	<file>.</file>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg name="cache" value=".phpcs-cache"/>
	<arg name="colors"/>
	<arg value="ps"/>

	<rule ref="WordPress">
		<!-- コメントは日本語で書くため、英文の句読点を前提とした整形ルールは適用しない -->
		<exclude name="Squiz.Commenting.InlineComment.InvalidEndChar"/>
		<exclude name="Squiz.Commenting.FileComment.SpacingAfterOpen"/>
		<exclude name="Squiz.Commenting.FunctionComment.ParamCommentFullStop"/>
		<!-- 日本語には大文字がないため「大文字で始めろ」は満たしようがない -->
		<exclude name="Generic.Commenting.DocComment.LongNotCapital"/>
		<exclude name="Generic.Commenting.DocComment.ShortNotCapital"/>
		<!-- docblock の @param / @package は必須としない -->
		<exclude name="Squiz.Commenting.FunctionComment.MissingParamTag"/>
		<exclude name="Squiz.Commenting.FileComment.MissingPackageTag"/>
		<!-- 日本語コメントに type="module" 等のコード片が混ざると
		     コメントアウトされたコードと誤判定されるため -->
		<exclude name="Squiz.PHP.CommentedOutCode.Found"/>
	</rule>
</ruleset>
